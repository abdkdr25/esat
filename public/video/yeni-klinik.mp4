<style id='responsive-menu-inline-css'>
/** This file is major component of this plugin so please don't try to edit here. */
#rmp_menu_trigger-6468 {
  width: 55px;
  height: 55px;
  position: fixed;
  top: 15px;
  border-radius: 5px;
  display: none;
  text-decoration: none;
  right: 5%;
  background: #000;
  transition: transform 0.5s, background-color 0.5s;
}
#rmp_menu_trigger-6468:hover, #rmp_menu_trigger-6468:focus {
  background: #000;
  text-decoration: unset;
}
#rmp_menu_trigger-6468.is-active {
  background: #000;
}
#rmp_menu_trigger-6468 .rmp-trigger-box {
  width: 25px;
  color: #fff;
}
#rmp_menu_trigger-6468 .rmp-trigger-icon-active, #rmp_menu_trigger-6468 .rmp-trigger-text-open {
  display: none;
}
#rmp_menu_trigger-6468.is-active .rmp-trigger-icon-active, #rmp_menu_trigger-6468.is-active .rmp-trigger-text-open {
  display: inline;
}
#rmp_menu_trigger-6468.is-active .rmp-trigger-icon-inactive, #rmp_menu_trigger-6468.is-active .rmp-trigger-text {
  display: none;
}
#rmp_menu_trigger-6468 .rmp-trigger-label {
  color: #fff;
  pointer-events: none;
  line-height: 13px;
  font-family: inherit;
  font-size: 14px;
  display: inline;
  text-transform: inherit;
}
#rmp_menu_trigger-6468 .rmp-trigger-label.rmp-trigger-label-top {
  display: block;
  margin-bottom: 12px;
}
#rmp_menu_trigger-6468 .rmp-trigger-label.rmp-trigger-label-bottom {
  display: block;
  margin-top: 12px;
}
#rmp_menu_trigger-6468 .responsive-menu-pro-inner {
  display: block;
}
#rmp_menu_trigger-6468 .rmp-trigger-icon-inactive .rmp-font-icon {
  color: #fff;
}
#rmp_menu_trigger-6468 .responsive-menu-pro-inner, #rmp_menu_trigger-6468 .responsive-menu-pro-inner::before, #rmp_menu_trigger-6468 .responsive-menu-pro-inner::after {
  width: 25px;
  height: 3px;
  background-color: #fff;
  border-radius: 4px;
  position: absolute;
}
#rmp_menu_trigger-6468 .rmp-trigger-icon-active .rmp-font-icon {
  color: #fff;
}
#rmp_menu_trigger-6468.is-active .responsive-menu-pro-inner, #rmp_menu_trigger-6468.is-active .responsive-menu-pro-inner::before, #rmp_menu_trigger-6468.is-active .responsive-menu-pro-inner::after {
  background-color: #fff;
}
#rmp_menu_trigger-6468:hover .rmp-trigger-icon-inactive .rmp-font-icon {
  color: #fff;
}
#rmp_menu_trigger-6468:not(.is-active):hover .responsive-menu-pro-inner, #rmp_menu_trigger-6468:not(.is-active):hover .responsive-menu-pro-inner::before, #rmp_menu_trigger-6468:not(.is-active):hover .responsive-menu-pro-inner::after {
  background-color: #fff;
}
#rmp_menu_trigger-6468 .responsive-menu-pro-inner::before {
  top: 10px;
}
#rmp_menu_trigger-6468 .responsive-menu-pro-inner::after {
  bottom: 10px;
}
#rmp_menu_trigger-6468.is-active .responsive-menu-pro-inner::after {
  bottom: 0;
}
/* Hamburger menu styling */
@media screen and (max-width: 8000px) {
  /** Menu Title Style */
  /** Menu Additional Content Style */
  #rmp_menu_trigger-6468 {
    display: block;
  }
  #rmp-container-6468 {
    position: fixed;
    top: 0;
    margin: 0;
    transition: transform 0.5s;
    overflow: auto;
    display: block;
    width: 75%;
    background-color: #212121;
    background-image: url("");
    height: 100%;
    left: 0;
    padding-top: 0px;
    padding-left: 0px;
    padding-bottom: 0px;
    padding-right: 0px;
  }
  #rmp-menu-wrap-6468 {
    padding-top: 0px;
    padding-left: 0px;
    padding-bottom: 0px;
    padding-right: 0px;
    background-color: #212121;
  }
  #rmp-menu-wrap-6468 .rmp-menu, #rmp-menu-wrap-6468 .rmp-submenu {
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
